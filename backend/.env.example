# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL 17 + pgvector) ---
# async driver for the app, sync driver is derived for Alembic
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_app

# --- Test database (used by pytest integration tests) ---
# Override DATABASE_URL to an isolated test database so tests never touch the
# application database.  The conftest.py guardrail refuses to run if the
# resolved DATABASE_URL does not contain the expected test-db name.
# Create it once:  docker exec <pgvector> psql -U postgres -c "CREATE DATABASE job_app_test;"
# Migrate it:      DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_app_test alembic upgrade head
# Then just run:   pytest -m integration
#
# Optional overrides (defaults shown):
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_app_test
# TEST_DATABASE_NAME=job_app_test

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-free JSON array or comma string handled by settings) ---
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Authentication (JWT + Google OAuth) ---
# JWT_SECRET: REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=insecure-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set REFRESH_COOKIE_SECURE=true in production (HTTPS).
REFRESH_COOKIE_SECURE=false
# Google OAuth client ID (server-side ID-token verification). Must match the
# frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=

# --- Legacy single seeded user (deprecated; auth now multi-user) ---
SEED_USER_EMAIL=me@example.com
SEED_USER_NAME=Me

# --- LLM providers (at least one required) ---
# Primary provider: openai | deepseek | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Optional job source fallback ---
JSEARCH_API_KEY=

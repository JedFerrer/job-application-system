# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL 17 + pgvector) ---
# async driver for the app, sync driver is derived for Alembic
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_app

# --- Destructive backend tests ---
# Run only with: python scripts/run_public_tests.py
# The runner creates and verifies separate disposable application-test and
# migration-test PostgreSQL instances. Do not set TEST_DATABASE_URL manually.

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0
# Leave empty unless the API is directly behind a known proxy network. Never
# trust arbitrary X-Forwarded-For values; verify the deployed proxy CIDRs first.
TRUSTED_PROXY_CIDRS=

# --- CORS (comma-free JSON array or comma string handled by settings) ---
# Development default; staging and production require explicit HTTPS origins
# and reject localhost, private IPs, and wildcard origins at startup.
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Authentication (JWT + Google OAuth) ---
# JWT_SECRET: REQUIRED in staging/production; use at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=insecure-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set REFRESH_COOKIE_SECURE=true in staging/production (HTTPS).
REFRESH_COOKIE_SECURE=false
# Google OAuth client ID (server-side ID-token verification). Must match the
# frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=

# --- Password-reset email delivery (Phase C2A development only) ---
# console is the safe default and returns a local reset link without sending.
# Set EMAIL_DELIVERY_MODE=resend only for an explicit local Resend test.
EMAIL_DELIVERY_MODE=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Job Application System
RESEND_REPLY_TO=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_PROVIDER_TIMEOUT_SECONDS=10
PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=300
# Tests always use a no-network provider. Public deployment configuration is deferred to Phase C2B.

# --- Legacy single seeded user (deprecated; auth now multi-user) ---
SEED_USER_EMAIL=me@example.com
SEED_USER_NAME=Me

# --- LLM providers (at least one required) ---
# Primary provider: openai | deepseek | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Optional job source fallback ---
JSEARCH_API_KEY=

# --- Job retention ---
# Active jobs older than this are marked expired by nightly maintenance.
JOB_ARCHIVE_AFTER_DAYS=30
ARCHIVE_SCHEDULE_CRON="0 2 * * *"
# Expired jobs without any user-created content are permanently purged.
JOB_PURGE_AFTER_DAYS=90
JOB_PURGE_BATCH_SIZE=500
PURGE_SCHEDULE_CRON="0 3 * * *"

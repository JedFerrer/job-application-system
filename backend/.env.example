# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL 17 + pgvector) ---
# async driver for the app, sync driver is derived for Alembic
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_app

# --- Redis (Celery broker + result backend) ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (comma-free JSON array or comma string handled by settings) ---
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Single seeded user (no auth in MVP) ---
SEED_USER_EMAIL=me@example.com
SEED_USER_NAME=Me

# --- LLM providers (at least one required) ---
# Primary provider: openai | deepseek | anthropic
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Optional job source fallback ---
JSEARCH_API_KEY=

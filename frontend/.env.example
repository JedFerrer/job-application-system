# URL the Next.js server uses to proxy API calls to FastAPI.
# Local dev (npm run dev): backend on localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000

# Google Identity Services OAuth client ID (public — safe to expose).
# Leave blank to disable the "Continue with Google" button; email/password
# sign-in still works. Must match GOOGLE_CLIENT_ID configured on the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
